@prefix : <https://www.opengis.net/def/csdm/examples/codelists/surveymark_condition_NZ/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix surv: <https://linked.data.gov.au/def/csdm/surveyfeatures/> .

<https://www.opengis.net/def/csdm/examples/codelists/surveymark_condition_NZ> a owl:Ontology ;
    owl:imports <http://www.w3.org/2004/02/skos/core>,
        <https://linked.data.gov.au/def/csdm/surveyfeatures.shapes>,
        <https://w3id.org/ogc/utils/label> ;
    owl:versionInfo "Created with TopBraid Composer" .

:New a surv:SurveyPointState ;
    rdfs:label "New" .

:Original a surv:SurveyPointState ;
    rdfs:label "Original" .

:SurveyMarkCondition_NZ a surv:SurveyMarkCondition ;
    rdfs:label "NZ Survey Mark Condition Codes" ;
    skos:hasTopConcept :Damaged,
        :Reliable .

:bound a surv:SurveyPointPurpose ;
    rdfs:label "boundary defined by survey" .

:ironspike a surv:MonumentForm ;
    rdfs:label "Iron Spike" .

:nonbound a surv:SurveyPointPurpose ;
    rdfs:label "non-boundary" .

:Damaged a surv:ConditionCode ;
    rdfs:label "Damaged" .

:Reliable a surv:MonumentCondition ;
    rdfs:label "Reliable" .

