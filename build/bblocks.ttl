<bblocks://icsm.csdm.model.parcelsalignment> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Model ;
    rdfs:label "CSDM Cadastral Parcels Alignment" ;
    dct:abstract "Deprecates the terms of the retired CSDM Cadastral Parcels module and maps each to the OGC Land Parcels term that replaces it, so the CSDM parcels IRIs still resolve."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-10-30T00:00:00+00:00"^^xsd:dateTime ;
