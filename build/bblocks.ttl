        <bblocks://icsm.csdm.utility.modelindex>,
        <bblocks://icsm.csdm.utility.ontexamples>,
        <bblocks://icsm.csdm.utility.reqmetamodel> ;
    skos:prefLabel "Building Blocks - 3D Cadastral Survey Data Model (CSDM) Ontologies" ;
