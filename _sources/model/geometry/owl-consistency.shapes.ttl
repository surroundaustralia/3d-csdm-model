<https://linked.data.gov.au/def/csdm/geometry.owl-shapes#ExtensionRule-description-max> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "At most 1 value(s) of description (OWL cardinality)."@en ;
