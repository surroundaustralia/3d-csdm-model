# baseURI: https://linked.data.gov.au/def/csdm/parcels
#
# CSDM Cadastral Parcels: alignment of the retired CSDM parcels module to the OGC Land Parcels ontology.
#
# The CSDM parcels module (https://linked.data.gov.au/def/csdm/parcels) was the source of the OGC Land Parcels
# ontology (https://w3id.org/ogc/ladm/parcels/), which the 3D CSDM exchange schema now uses. Each CSDM parcels term is
# deprecated and mapped to the Land Parcels term with the same name, so that the CSDM IRIs still resolve.
# Generated from working/retired/parcels/parcels.ttl and the Land Parcels ontology on 2026-10-30.

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix :     <https://linked.data.gov.au/def/csdm/parcels/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix ladm: <https://w3id.org/ogc/ladm/parcels/> .
@prefix ont:  <https://linked.data.gov.au/def/csdm/parcels> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ont:
  a owl:Ontology ;
  rdfs:label "CSDM Cadastral Parcels (alignment to OGC Land Parcels)"@en ;
  dct:description "Deprecated CSDM parcels terms, each mapped to the OGC Land Parcels term that replaces it."@en ;
  dct:isReplacedBy <https://w3id.org/ogc/ladm/parcels> ;
  dct:source <https://github.com/icsm-au/3d-csdm/blob/main/csdm_model/parcels.ttl> ;
  owl:versionInfo "0.2" ;
.

:Appellation
  a owl:Class ;
  rdfs:isDefinedBy ont: ;
  rdfs:label "Appellation (deprecated)"@en ;
  owl:deprecated true ;
  owl:equivalentClass ladm:Appellation ;
  dct:isReplacedBy ladm:Appellation ;
.

:CodeTypes
  a owl:Class ;
  rdfs:isDefinedBy ont: ;
  rdfs:label "Code Types (deprecated)"@en ;
  owl:deprecated true ;
  owl:equivalentClass ladm:CodeTypes ;
  dct:isReplacedBy ladm:CodeTypes ;
.

:Estate
  a owl:Class ;
  rdfs:isDefinedBy ont: ;
  rdfs:label "Estate (deprecated)"@en ;
  owl:deprecated true ;
  owl:equivalentClass ladm:Estate ;
  dct:isReplacedBy ladm:Estate ;
.

:EstateParcel
  a owl:Class ;
  rdfs:isDefinedBy ont: ;
  rdfs:label "Estate Parcel (deprecated)"@en ;
  owl:deprecated true ;
  owl:equivalentClass ladm:EstateParcel ;
  dct:isReplacedBy ladm:EstateParcel ;
.

:LandInterest
  a owl:Class ;
  rdfs:isDefinedBy ont: ;
  rdfs:label "Interest In Land (deprecated)"@en ;
  owl:deprecated true ;
  owl:equivalentClass ladm:LandInterest ;
  dct:isReplacedBy ladm:LandInterest ;
.

:Parcel
