  rdfs:isDefinedBy ont: ;
  rdfs:label "Parcel Module Component (deprecated)"@en ;
  owl:deprecated true ;
  skos:historyNote "No OGC Land Parcels counterpart. The CSDM module used this class to group the parcel model classes for documentation."@en ;
.

