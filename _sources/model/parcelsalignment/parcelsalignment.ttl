  rdfs:label "Parcel Aggregate (deprecated)"@en ;
  owl:deprecated true ;
  owl:equivalentClass ladm:ParcelAggregate ;
  dct:isReplacedBy ladm:ParcelAggregate ;
.

:ParcelModel
