# baseURI: https://linked.data.gov.au/def/csdm/surveyfeatures.shapes
# imports: http://datashapes.org/dash
# imports: https://w3id.org/ogc/utils/label
# imports: https://linked.data.gov.au/def/csdm/surveyfeatures

@prefix com:              <https://w3id.org/ogc/utils/label/> .
@prefix dash:             <http://datashapes.org/dash#> .
@prefix dct:              <http://purl.org/dc/terms/> .
@prefix geosparql:        <http://www.opengis.net/ont/geosparql#> .
@prefix landinfra:        <http://www.opengis.net/def/schema/landinfra/core/> .
@prefix metadata:         <http://topbraid.org/metadata#> .
@prefix ontologyprojects: <http://teamwork.topbraidlive.org/ontologyprojects#> .
@prefix owl:              <http://www.w3.org/2002/07/owl#> .
@prefix prof:             <http://www.w3.org/ns/dx/prof/> .
@prefix rdf:              <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:             <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:               <http://www.w3.org/ns/shacl#> .
@prefix skos:             <http://www.w3.org/2004/02/skos/core#> .
@prefix specs:            <https://linked.data.gov.au/def/csdm/impspecs/> .
@prefix surv:             <https://linked.data.gov.au/def/csdm/surveyfeatures/> .
@prefix teamwork:         <http://topbraid.org/teamwork#> .
@prefix xsd:              <http://www.w3.org/2001/XMLSchema#> .

<https://linked.data.gov.au/def/csdm/surveyfeatures.shapes>
    a owl:Ontology ;
    # owl:imports <http://datashapes.org/dash> ;
    # owl:imports <https://w3id.org/ogc/utils/label> ;
    # owl:imports <https://linked.data.gov.au/def/csdm/surveyfeatures> ;
.

surv:AdoptedVector
    a sh:NodeShape ;
    sh:targetClass surv:AdoptedVector ;  # generated: tools/shape-targets.py
.

surv:AllowableCoordinateReferenceSystem
    a sh:NodeShape ;
    sh:targetClass surv:AllowableCoordinateReferenceSystem ;  # generated: tools/shape-targets.py
.

surv:Angle
    a sh:NodeShape ;
    sh:targetClass surv:Angle ;  # generated: tools/shape-targets.py
.

surv:BoundaryMark
    a           sh:NodeShape ;
    sh:targetClass surv:BoundaryMark ;  # generated: tools/shape-targets.py
.

surv:CadastralMark
    a sh:NodeShape ;
    sh:targetClass surv:CadastralMark ;  # generated: tools/shape-targets.py
.

surv:Distance
    a sh:NodeShape ;
    sh:targetClass surv:Distance ;  # generated: tools/shape-targets.py
.

surv:GeodeticReferenceMark
    a sh:NodeShape ;
    sh:targetClass surv:GeodeticReferenceMark ;  # generated: tools/shape-targets.py
.

surv:Monument
    a           sh:NodeShape ;
    sh:targetClass surv:Monument ;  # generated: tools/shape-targets.py
    sh:property surv:Monument-condition ;
    sh:property surv:Monument-form ;
    sh:property surv:Monument-replaces ;
    sh:property surv:SurveyMark-state ;
.

surv:Monument-condition
    a        sh:PropertyShape ;
    sh:path  surv:condition ;
    sh:nodeKind sh:IRI ;
    sh:name  "condition" ;
.

surv:Monument-form
    a           sh:PropertyShape ;
    sh:path     surv:form ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
.

surv:Monument-replaces
    a        sh:PropertyShape ;
    sh:path  surv:replaces ;
    sh:node surv:Monument ;
    sh:name  "replaces" ;
.

surv:NoOccupation
    a sh:NodeShape ;
    sh:targetClass surv:NoOccupation ;  # generated: tools/shape-targets.py
.

surv:ObservedVector
    a sh:NodeShape ;
    sh:targetClass surv:ObservedVector ;  # generated: tools/shape-targets.py
.

surv:Occupation
    a sh:NodeShape ;
    sh:targetClass <https://linked.data.gov.au/def/csdm/surveyobs/DesignModel>, <https://linked.data.gov.au/def/csdm/surveyobs/OccupationAsFeature>, surv:NoOccupation, surv:Occupation, surv:Terrain ;  # generated: tools/shape-targets.py
.

surv:OccupationMark
    a sh:NodeShape ;
    sh:targetClass <https://linked.data.gov.au/def/csdm/surveyobs/OccupationModelVertex>, surv:OccupationMark ;  # generated: tools/shape-targets.py
.

surv:SurveyMark
    a           sh:NodeShape ;
    sh:targetClass surv:BoundaryMark, surv:CadastralMark, surv:GeodeticReferenceMark, surv:SurveyMark ;  # generated: tools/shape-targets.py
    sh:property surv:SurveyMark-monumentedBy ;
.

surv:SurveyMark-monumentedBy
    a           sh:PropertyShape ;
    sh:path     surv:monumentedBy ;
    sh:node     surv:Monument ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name     "monumentedBy" ;
    sh:nodeKind sh:BlankNodeOrIRI ;
.

surv:SurveyMark-state
    a           sh:PropertyShape ;
    sh:path     surv:state ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name     "state" ;
    sh:nodeKind sh:BlankNodeOrIRI ;
.

surv:SurveyPoint
    a           sh:NodeShape ;
    sh:targetClass <https://linked.data.gov.au/def/csdm/surveyobs/OccupationModelVertex>, surv:BoundaryMark, surv:CadastralMark, surv:GeodeticReferenceMark, surv:OccupationMark, surv:SurveyMark, surv:SurveyPoint ;  # generated: tools/shape-targets.py
    sh:name     "Survey Point" ;
    sh:property surv:SurveyPoint-hasGeometry ;
    sh:property surv:SurveyPoint-name ;
    sh:property surv:SurveyPoint-provenance ;
    sh:property surv:SurveyPoint-purpose ;
.

surv:SurveyPoint-hasGeometry
    a           sh:PropertyShape ;
    sh:path     <http://www.opengis.net/ont/geosparql#hasGeometry> ;
    rdfs:comment
                "Note that a Survey Point may not have a geometry declared - it may be identified and described and its location determined at a future date." ;
    sh:or ( [ sh:class <http://www.opengis.net/ont/sf#Point> ] [ sh:class <http://www.opengis.net/ont/gml#Point> ] ) ;
    sh:group    <http://topbraid.org/tosh#PropertyAxiomsPropertyGroup> ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNodeOrIRI ;
.

surv:SurveyPoint-name
    a           sh:PropertyShape ;
    sh:path     com:name ;
    dash:viewer dash:DetailsViewer ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:name     "name" ;
    sh:nodeKind sh:BlankNodeOrIRI ;
.

surv:SurveyPoint-provenance
    a           sh:PropertyShape ;
    sh:path     surv:provenance ;
    sh:class    surv:SurveyPointProvenance ;
    sh:nodeKind sh:IRI ;
.

surv:SurveyPoint-purpose
    a           sh:PropertyShape ;
    sh:path     surv:purpose ;
    sh:minCount 1 ;
    sh:name     "purpose" ;
    sh:nodeKind sh:IRI ;
.

surv:SurveyPointProvenance
    a sh:NodeShape ;
    sh:targetClass surv:SurveyPointProvenance ;  # generated: tools/shape-targets.py
.

surv:SurveyedLine
    a           sh:NodeShape ;
    sh:targetClass surv:AdoptedVector, surv:ObservedVector, surv:SurveyedLine, surv:SurveyedVector ;  # generated: tools/shape-targets.py
    sh:property surv:SurveyedLine-purpose ;
    sh:property surv:SurveyedLine-distance ;
    sh:property surv:SurveyedLine-from ;
    sh:property surv:SurveyedLine-horizontalAngle ;
    sh:property surv:SurveyedLine-target ;
    sh:property surv:SurveyedLine-verticalAngle ;
.

surv:SurveyedLine-distance
    a        sh:PropertyShape ;
    sh:path  surv:distance ;
    sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:integer ] ) ;
.

surv:SurveyedLine-from
    a           sh:PropertyShape ;
    sh:path     surv:from ;
    sh:class    surv:SurveyPoint ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
.

surv:SurveyedLine-purpose
    a           sh:PropertyShape ;
    sh:path     surv:vectorPurpose ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
.

surv:SurveyedLine-horizontalAngle
    a        sh:PropertyShape ;
    sh:path  surv:horizontalAngle ;
    sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:integer ] ) ;
.

surv:SurveyedLine-source
    a        sh:PropertyShape ;
    sh:path  surv:from ;
    sh:class surv:SurveyMark ;
.

surv:SurveyedLine-target
    a           sh:PropertyShape ;
    sh:path     surv:target ;
    sh:class    surv:SurveyPoint ;
    sh:maxCount 1 ;
    sh:minCount 0 ;
    sh:nodeKind sh:IRI ;
.

surv:SurveyedLine-verticalAngle
    a           sh:PropertyShape ;
    sh:path     surv:verticalAngle ;
    sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] [ sh:datatype xsd:float ] [ sh:datatype xsd:integer ] ) ;
.
